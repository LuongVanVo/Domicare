# Production env example
APP_NAME=domicare-backend
APP_DOMAIN=api.example.com
APP_PORT=8888

# Django
DJANGO_SETTINGS_MODULE=config.settings.base
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=api.example.com

# Database
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=change-me
DB_HOST=your-db-host
DB_PORT=5432

# JWT
JWT_SECRET_KEY=change-me
JWT_EXPIRATION_MINUTES=30

# Redis (if used)
REDIS_URL=redis://redis:6379/0

# Cloudinary
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me

# Frontend/Backend URLs
FRONTEND_URL=https://example.com
BACKEND_URL=https://api.example.com
LOGO_URL=

# Google OAuth2
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

# VNPay
VNPAY_TMN_CODE=change-me
VNPAY_SECURE_HASH=change-me
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://api.example.com/api/v1/payment/return-payment
VNPAY_FRONTEND_URL=https://example.com
